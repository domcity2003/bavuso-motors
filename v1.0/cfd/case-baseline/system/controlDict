FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
// Bavuso V1.0 baseline aero case, written 2026-10-29 by Claude Opus 5.5

application     foamRun;
solver          incompressibleFluid;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         800;
deltaT          1;
writeControl    timeStep;
writeInterval   400;
purgeWrite      2;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
runTimeModifiable true;

functions
{
    forces_total
    {
        type        forces;
        libs        ("libforces.so");
        writeControl timeStep;
        writeInterval 1;
        log         true;
        patches     ("(bike|rider|wheel_front|wheel_rear).*");
        p p; U U;
        rho         rhoInf;
        rhoInf      1.204;
        CofR        (0.74 0 0);   // between the axles, on the ground
    }
    forces_bike
    {
        type        forces;
        libs        ("libforces.so");
        writeControl timeStep;
        writeInterval 1;
        log         false;
        patches     ("bike.*");
        p p; U U;
        rho         rhoInf;
        rhoInf      1.204;
        CofR        (0.74 0 0);   // between the axles, on the ground
    }
    forces_rider
    {
        type        forces;
        libs        ("libforces.so");
        writeControl timeStep;
        writeInterval 1;
        log         false;
        patches     ("rider.*");
        p p; U U;
        rho         rhoInf;
        rhoInf      1.204;
        CofR        (0.74 0 0);   // between the axles, on the ground
    }
    forces_wheels
    {
        type        forces;
        libs        ("libforces.so");
        writeControl timeStep;
        writeInterval 1;
        log         false;
        patches     ("wheel_.*");
        p p; U U;
        rho         rhoInf;
        rhoInf      1.204;
        CofR        (0.74 0 0);   // between the axles, on the ground
    }
    yPlus { type yPlus; libs ("libfieldFunctionObjects.so"); writeControl writeTime; }
}
