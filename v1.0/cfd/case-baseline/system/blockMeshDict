FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object blockMeshDict;
}
// Bavuso V1.0 baseline aero case, written 2026-10-29 by Claude Opus 5.5

// Wind tunnel around the bike. X forward, air flows towards -X.
// Floor at Z = 0.010 m so the tyres sink 10 mm into it (avoids knife-edge contact cells).
convertToMeters 1;
xmin -8.0; xmax 5.5; ymin -3.0; ymax 3.0; zmin 0.010; zmax 3.5;
vertices
(
    ($xmin $ymin $zmin) ($xmax $ymin $zmin) ($xmax $ymax $zmin) ($xmin $ymax $zmin)
    ($xmin $ymin $zmax) ($xmax $ymin $zmax) ($xmax $ymax $zmax) ($xmin $ymax $zmax)
);
blocks ( hex (0 1 2 3 4 5 6 7) (54 24 14) simpleGrading (1 1 1) );   // 0.25 m base cells
boundary
(
    inlet   { type patch;    faces ((1 2 6 5)); }
    outlet  { type patch;    faces ((0 4 7 3)); }
    ground  { type wall;     faces ((0 3 2 1)); }
    tunnel  { type symmetry; faces ((4 5 6 7) (0 1 5 4) (3 7 6 2)); }
);
