FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object p;
    "proc.*"   { type processor; }
}
// Bavuso V1.0 baseline aero case, written 2026-10-29 by Claude Opus 5.5

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    inlet       { type zeroGradient; }
    outlet      { type fixedValue; value uniform 0; }
    ground      { type zeroGradient; }
    tunnel      { type symmetry; }
    "(bike|rider).*" { type zeroGradient; }
    "wheel_front.*" { type zeroGradient; }
    "wheel_rear.*" { type zeroGradient; }
    "proc.*"   { type processor; }
}
