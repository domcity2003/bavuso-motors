internalField   uniform 0.116;
boundaryField
{
    inlet       { type fixedValue; value uniform 0.116; }
    outlet      { type inletOutlet; inletValue uniform 0.116; value uniform 0.116; }
    ground      { type kqRWallFunction; value uniform 0.116; }
    tunnel      { type symmetry; }
    "(bike|rider).*" { type kqRWallFunction; value uniform 0.116; }
    "wheel_front.*" { type kqRWallFunction; value uniform 0.116; }
    "wheel_rear.*" { type kqRWallFunction; value uniform 0.116; }
    "proc.*"   { type processor; }
}
